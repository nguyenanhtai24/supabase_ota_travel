# Cổng chạy ứng dụng ở local
PORT=5000

# Chuỗi kết nối PostgreSQL (Supabase)
# Định dạng: postgresql://[user]:[password]@[host]:[port]/[database]
# Lấy từ Supabase Dashboard -> Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres

# API Key cố định để xác thực các request đến API
# Thay bằng chuỗi bí mật của riêng bạn (không commit file .env thật lên Git)
API_SECRET_KEY=ota_sk_change_this_to_your_own_secret_key
